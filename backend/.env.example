APP_NAME=Spec2Test
DEBUG=False

# Supabase Postgres (Session pooler example):
# postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# Comma-separated list
CORS_ORIGINS=http://localhost:3000,https://your-netlify-site.netlify.app
